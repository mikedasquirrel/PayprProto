# paypr environment — copy to .env (dev) or set these in the PythonAnywhere
# web-app "Environment variables" panel (prod). These are the EXACT names the
# code reads (config.py). Values shown are placeholders.

# ── Core ────────────────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string          # Flask session signing (REQUIRED, strong)
JWT_SECRET_KEY=change-me-to-a-different-long-random    # unlock-token signing (REQUIRED, strong)
PUBLIC_BASE_URL=https://paypr.pro                      # used to build links in emails

# ── Database ────────────────────────────────────────────────────────────────
# The code reads DATABASE_URL (NOT SQLALCHEMY_DATABASE_URI). Postgres for prod.
DATABASE_URL=sqlite:////home/youruser/paypr/paypr.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/paypr

# ── Stripe (payments) ───────────────────────────────────────────────────────
# The code reads STRIPE_API_KEY; STRIPE_SECRET_KEY is also accepted as a fallback.
STRIPE_API_KEY=sk_live_xxx                             # secret key (sk_live_… in prod, sk_test_… to test)
STRIPE_PUBLISHABLE_KEY=pk_live_xxx                     # publishable key
STRIPE_WEBHOOK_SECRET=whsec_xxx                        # from the webhook you create in Stripe (see below)
# Webhook to create in Stripe → Developers → Webhooks:
#   URL:    https://paypr.pro/api/stripe/webhook
#   Events: checkout.session.completed

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx                                  # from resend.com → API Keys
PAYPR_MAIL_FROM=paypr <no-reply@paypr.pro>             # sender MUST be on a Resend-verified domain

# ── Money knobs (safe defaults) ─────────────────────────────────────────────
PLATFORM_FEE_BPS=0                                     # ZERO-FEE DOCTRINE: no usage fee. If one ever ships it is a flat ~5c (new knob), never a percentage.
DAILY_SPEND_CAP_CENTS=1500                             # per-reader daily cap ($15)
WELCOME_CREDIT_CENTS=0                                 # starter credit; keep 0 (a faucet otherwise)

# ── Optional ────────────────────────────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn
# RATE_LIMIT_STORAGE=redis://localhost:6379            # durable rate limits across workers
DEFAULT_PORT=5001
FEATURE_PDF=true
FEATURE_AUDIO=true
